NODE_ENV=development
PORT=3333

# Origens do front-end liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# Com o docker compose da raiz, o host é "db"
DB_HOST=localhost
DB_PORT=3306
DB_NAME=atelie_afro
DB_USER=atelie
DB_PASSWORD=troque-esta-senha

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=1h

# O token de renovação vai num cookie httpOnly. Dias até a sessão expirar sem uso:
REFRESH_TOKEN_DAYS=7
# lax serve quando front e API ficam no mesmo site (mesmo domínio registrável, portas diferentes valem).
# Em domínios diferentes use none, que força o cookie Secure (só HTTPS).
COOKIE_SAMESITE=lax
