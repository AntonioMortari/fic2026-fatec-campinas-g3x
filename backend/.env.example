# Copie para .env e preencha. O .env NUNCA vai para o Git (RNF-SEG-05).

NODE_ENV=development
PORTA=3333

# Origens do front-end autorizadas pelo CORS (RNF-SEG-04), separadas por vírgula.
CORS_ORIGENS=http://localhost:5173

# Banco MySQL. Com o docker compose da raiz, o host é "db".
DB_HOST=localhost
DB_PORTA=3306
DB_NOME=atelie_afro
DB_USUARIO=atelie
DB_SENHA=troque-esta-senha

# Chave de assinatura do JWT (RNF-SEG-01/05). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SEGREDO=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRA_EM=1h
